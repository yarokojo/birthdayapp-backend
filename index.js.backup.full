// ✅ Get all users (for search/find friends)
app.get("/api/users", verifyToken, (req, res) => {
  const userId = req.userId;
  console.log(`👥 GET /api/users for user ${userId}`);
  
  const allUsers = data.users.map(user => ({
    id: user.id,
