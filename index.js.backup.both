    console.error('❌ Get banners error:', error);
    res.json({
      success: true,
      banners: [
        {
          id: 'banner_fallback_1',
          title: '🎉 Today\'s Celebrations',
          subtitle: 'Check out today\'s events!',
          icon: '🎂',
          colors: ['#6366f1', '#8b5cf6', '#a855f7'],
