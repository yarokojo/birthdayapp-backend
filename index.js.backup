app.post('/api/gifts/purchase', verifyToken, async (req, res) => {
  try {
    const { giftId, giftName, amount, network, phoneNumber, recipientId, recipientName } = req.body;
    if (!giftId || !amount || !recipientId) return res.status(400).json({ error: 'Missing required fields' });
    const amt = parseFloat(amount);
    await query('UPDATE wallets SET balance = balance + $1, total_received = total_received + $1 WHERE user_id = $2', [amt, recipientId]);
    await query(
      `INSERT INTO gifts (sender_id, recipient_id, gift_id, gift_name, amount, network, phone_number, status, completed_at)
       VALUES ($1, $2, $3, $4, $5, $6, $7, 'completed', CURRENT_TIMESTAMP)`,
      [req.userId, recipientId, giftId, giftName, amt, network || 'MTN', phoneNumber || '']
    );
    res.json({ success: true });
  } catch (e) {
    res.status(500).json({ error: 'Purchase gift failed' });
  }
});

// ============ CALENDAR ============
app.get('/api/calendar/events/me', verifyToken, async (req, res) => {
  try {
    const result = await query('SELECT * FROM calendar_events WHERE user_id = $1 ORDER BY date ASC', [req.userId]);
    res.json({ events: result.rows });
  } catch (e) {
    res.json({ events: [] });
  }
});

app.post('/api/calendar/events', verifyToken, async (req, res) => {
  try {
    const { title, date, type, celebrantName, celebrantId, reminderSet } = req.body;
    const result = await query(
      `INSERT INTO calendar_events (user_id, title, date, type, celebrant_name, celebrant_id, reminder_set)
       VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING *`,
      [req.userId, title, date, type || 'birthday', celebrantName, celebrantId, reminderSet || false]
    );
    res.status(201).json({ event: result.rows[0] });
  } catch (e) {
    res.status(500).json({ error: 'Create event failed' });
  }
});

app.delete('/api/calendar/events/:id', verifyToken, async (req, res) => {
  await query('DELETE FROM calendar_events WHERE id = $1 AND user_id = $2', [req.params.id, req.userId]);
  res.json({ success: true });
});

app.put('/api/calendar/events/:id/reminder', verifyToken, async (req, res) => {
  const result = await query(
    'UPDATE calendar_events SET reminder_set = NOT reminder_set WHERE id = $1 AND user_id = $2 RETURNING *',
    [req.params.id, req.userId]
  );
  res.json({ event: result.rows[0] });
});

// ============ LEADERBOARD ============
app.get('/api/leaderboard', verifyToken, async (req, res) => {
  try {
    const result = await query(`
      SELECT u.id, u.name, u.username, u.profile_image,
      COUNT(DISTINCT p.id) as posts,
      COUNT(DISTINCT l.id) as likes,
      COUNT(DISTINCT c.id) as comments,
      (COUNT(DISTINCT p.id) * 10 + COUNT(DISTINCT l.id) * 2 + COUNT(DISTINCT c.id) * 5) as score
      FROM users u
      LEFT JOIN posts p ON p.user_id = u.id
      LEFT JOIN post_likes l ON l.user_id = u.id
      LEFT JOIN comments c ON c.user_id = u.id
      WHERE u.is_active = true
      GROUP BY u.id
      ORDER BY score DESC
      LIMIT 20
    `);
    const users = result.rows.map((u, i) => ({
      id: u.id,
      name: u.name,
      username: u.username,
      profileImage: u.profile_image || 'https://randomuser.me/api/portraits/men/1.jpg',
      score: parseInt(u.score) || 0,
      posts: parseInt(u.posts) || 0,
      likes: parseInt(u.likes) || 0,
      comments: parseInt(u.comments) || 0,
      rank: i + 1
    }));
    res.json({ users });
  } catch (e) {
    res.json({ users: [] });
  }
});

// ============ STORIES ============
app.get('/api/stories', verifyToken, async (req, res) => {
  try {
    const result = await query(
      `SELECT s.*, u.name as user_name, u.username, u.profile_image as user_avatar
       FROM stories s JOIN users u ON u.id = s.user_id
       WHERE s.expires_at > NOW() ORDER BY s.created_at DESC LIMIT 20`,
      [req.userId]
    );
    res.json({ stories: result.rows });
  } catch (e) {
    res.json({ stories: [] });
  }
});

app.post('/api/stories', verifyToken, async (req, res) => {
  try {
    const { contentUrl, isVideo, caption, privacy } = req.body;
    if (!contentUrl) return res.status(400).json({ error: 'Content URL required' });
    const result = await query(
      `INSERT INTO stories (user_id, content_url, is_video, caption, privacy, expires_at)
       VALUES ($1, $2, $3, $4, $5, NOW() + INTERVAL '24 hours') RETURNING *`,
      [req.userId, contentUrl, isVideo || false, caption || '', privacy || 'friends']
    );
    res.status(201).json({ story: result.rows[0] });
  } catch (e) {
    res.status(500).json({ error: 'Create story failed' });
  }
});

app.delete('/api/stories/:id', verifyToken, async (req, res) => {
  await query('DELETE FROM stories WHERE id = $1 AND user_id = $2', [req.params.id, req.userId]);
  res.json({ success: true });
});

app.post('/api/stories/:id/like', verifyToken, async (req, res) => {
  await query('UPDATE stories SET likes_count = likes_count + 1 WHERE id = $1', [req.params.id]);
  res.json({ success: true });
});

app.delete('/api/stories/:id/like', verifyToken, async (req, res) => {
  await query('UPDATE stories SET likes_count = GREATEST(likes_count - 1, 0) WHERE id = $1', [req.params.id]);
  res.json({ success: true });
});

