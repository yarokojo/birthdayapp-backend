});

app.delete("/api/friends/:friendId", verifyToken, async (req, res) => {
  const { friendId } = req.params;

  try {
    await query(
      `DELETE FROM friends
       WHERE (user_id = $1 AND friend_id = $2) OR (user_id = $2 AND friend_id = $1)`,
