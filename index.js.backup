// ============================================================
// ✅ FIXED: GET /api/friends/requests - Get pending friend requests
// ============================================================
app.get("/api/friends/requests", verifyToken, async (req, res) => {
  try {
    const userId = req.userId;
    console.log(`👋 [FRIENDS] GET /friends/requests for user: ${userId}`);

    const result = await query(
      `SELECT 
        fr.id, 
        fr.from_user_id, 
        fr.status, 
        fr.created_at,
        u.id as "fromUserId",
        u.name as "fromUserName",
        u.username as "fromUserUsername",
        u.profile_image as "fromUserAvatar",
        u.birth_date as "fromUserBirthDate"
       FROM friend_requests fr
       JOIN users u ON u.id = fr.from_user_id
       WHERE fr.to_user_id = $1 AND fr.status = 'pending'
       ORDER BY fr.created_at DESC`,
      [userId]
    );

    console.log(`✅ Found ${result.rows.length} pending requests`);

    // ✅ Format the response EXACTLY as the frontend expects
    const formattedRequests = result.rows.map(row => ({
      id: row.id,
      fromUserId: row.from_user_id,
      fromUserName: row.fromUserName,
      fromUserUsername: row.fromUserUsername || '@user',
      fromUserAvatar: row.fromUserAvatar || 'https://randomuser.me/api/portraits/men/1.jpg',
      fromUserBirthDate: row.fromUserBirthDate,
      status: row.status,
      createdAt: row.created_at,
      // ✅ Also include nested fromUser object for compatibility
      fromUser: {
        id: row.from_user_id,
        name: row.fromUserName,
        username: row.fromUserUsername || '@user',
        profileImage: row.fromUserAvatar || 'https://randomuser.me/api/portraits/men/1.jpg',
        birthDate: row.fromUserBirthDate
      }
    }));

    console.log('📤 Sending response:', JSON.stringify(formattedRequests, null, 2));

    res.json({ 
      success: true,
      requests: formattedRequests 
    });
  } catch (error) {
    console.error("❌ GET /friends/requests error:", error);
    res.status(500).json({ 
      success: false,
      error: "Failed to get friend requests", 
      details: error.message,
      requests: []
    });
  }
});
