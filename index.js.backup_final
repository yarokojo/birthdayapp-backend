// ============================================================
// UPLOAD CONFIGURATION - LARGE FILE SUPPORT
// ============================================================

// Update multer configuration for larger files
const multer = require('multer');
const path = require('path');
const fs = require('fs');

// Ensure uploads directory exists
const uploadsDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadsDir)) {
  fs.mkdirSync(uploadsDir, { recursive: true });
  console.log('📁 Created uploads directory');
}

// Configure storage
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, 'uploads/');
  },
  filename: (req, file, cb) => {
    const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
    const ext = path.extname(file.originalname);
    let baseName = 'upload';
    
    if (file.fieldname === 'video') {
      baseName = 'video';
    } else if (file.fieldname === 'image') {
      baseName = 'image';
    }
    
    cb(null, baseName + '-' + uniqueSuffix + ext);
  }
});

// Configure multer with larger limits
const upload = multer({
  storage: storage,
  limits: { 
    fileSize: 50 * 1024 * 1024, // 50MB max for videos
    fieldSize: 50 * 1024 * 1024,
  },
  fileFilter: (req, file, cb) => {
    const allowedImageTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/heic'];
    const allowedVideoTypes = ['video/mp4', 'video/quicktime', 'video/x-msvideo', 'video/webm'];
    const allAllowed = [...allowedImageTypes, ...allowedVideoTypes];
    
    if (allAllowed.includes(file.mimetype)) {
      cb(null, true);
    } else {
      cb(new Error(`File type not allowed: ${file.mimetype}`), false);
    }
  }
});

// Serve uploaded files statically
app.use('/uploads', express.static('uploads'));

// Upload image endpoint - larger file support
app.post('/api/upload/image', verifyToken, upload.single('image'), (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'No image file uploaded' });
    }
    
    console.log('📸 Image uploaded:', req.file.filename);
    console.log('📊 File size:', req.file.size);
    console.log('📊 File type:', req.file.mimetype);
    
    const imageUrl = `${req.protocol}://${req.get('host')}/uploads/${req.file.filename}`;
    res.json({ success: true, imageUrl });
  } catch (error) {
    console.error('❌ Image upload error:', error);
    res.status(500).json({ error: 'Image upload failed: ' + error.message });
  }
});

// Upload video endpoint - larger file support
app.post('/api/upload/video', verifyToken, upload.single('video'), (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ error: 'No video file uploaded' });
    }
    
    console.log('🎬 Video uploaded:', req.file.filename);
    console.log('📊 File size:', req.file.size);
    console.log('📊 File type:', req.file.mimetype);
    
    const videoUrl = `${req.protocol}://${req.get('host')}/uploads/${req.file.filename}`;
    res.json({ success: true, videoUrl });
  } catch (error) {
    console.error('❌ Video upload error:', error);
    res.status(500).json({ error: 'Video upload failed: ' + error.message });
  }
});

// Error handling middleware for multer
app.use((err, req, res, next) => {
  if (err instanceof multer.MulterError) {
    if (err.code === 'FILE_TOO_LARGE') {
      return res.status(413).json({ error: 'File too large. Maximum size is 50MB.' });
    }
    return res.status(400).json({ error: err.message });
  }
  next(err);
});

console.log('✅ Upload routes with large file support loaded');
app.use('/api/stories', require('./src/routes/stories'));
